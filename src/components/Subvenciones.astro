---
import { Image } from 'astro:assets';
import logoCdti from '../assets/sponsors/logo_cdti.webp';
import logoEnisa from '../assets/sponsors/logo_enisa.webp';
---

<div class="flex flex-row justify-center gap-2 mb-2">
  <div class="bg-white rounded-lg p-1.5 flex items-center relative overflow-hidden">
    <Image
      src={logoCdti}
      alt="Logo CDTI"
      class="w-auto h-[40px] sm:h-[50px] md:h-[55px] object-contain"
    />
    <div class="absolute inset-0 bg-gray-950/20 pointer-events-none"></div>
  </div>
  <div class="bg-white rounded-lg p-1.5 flex items-center relative overflow-hidden">
    <Image
      src={logoEnisa}
      alt="Logo ENISA"
      class="w-auto h-[40px] sm:h-[50px] md:h-[55px] object-contain"
    />
    <div class="absolute inset-0 bg-gray-950/20 pointer-events-none"></div>
  </div>
</div>
