---
import { Image } from 'astro:assets';
import logoCdti from '../assets/sponsors/logo_cdti.webp';

const isMobile = true;
---

<div class="flex flex-row justify-center gap-2 mb-2">
  <Image
    src={logoCdti}
    alt="Logo CDTI"
    format="webp"
    class="w-[100px] h-auto sm:w-[150px] md:w-[192px]"
  />
</div>
