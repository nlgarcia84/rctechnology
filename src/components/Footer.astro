---
import { t } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

const locale: Locale = Astro.locals.locale ?? 'es';
---

<footer class="bg-red-700 text-white px-4 py-10 w-full shadow-lg">
  <div
    class="max-w-6xl mx-auto flex flex-col md:flex-row items-start md:items-center justify-between gap-6"
  >
    <div class="text-sm leading-relaxed">
      RC Technology Solutions SL. CIF: B56360894<br />
      Gran Vía de les Corts Catalanes 620, ático 4A, 08007 Barcelona<br />
      <a href="mailto:rafael@rctechnology.es" class="underline"
        >rafael@rctechnology.es</a
      ><br />
      <a href="tel:+34608848171" class="underline">+34 608 848 171</a>
    </div>

    <nav class="text-sm">
      <ul class="flex flex-col md:flex-row gap-3 md:gap-6 text-white/90">
        <li>
          <a href="/politica-privacidad" class="hover:underline"
            >{t(locale, 'footer.privacy')}</a>
        </li>
        <li>
          <a href="/politica-cookies" class="hover:underline"
            >{t(locale, 'footer.cookies')}</a>
        </li>
        <li>
          <a href="/terminos-servicio" class="hover:underline"
            >{t(locale, 'footer.terms')}</a>
        </li>
        <li><a href="/aviso-legal" class="hover:underline">{t(locale, 'footer.legal')}</a></li>
      </ul>
    </nav>
  </div>

  <div class="mt-6 text-xs text-white/70 text-center">
    {t(locale, 'footer.rights')}
  </div>
</footer>
