---
import Button from './Button.astro';
import { Picture } from 'astro:assets';
import logo from '../assets/rctlogo.png';
import logoMobile from '../assets/rctlogo_mobile.png';
---

<header
  class="grid grid-cols-2 md:grid-cols-3 items-center px-5 py-4 md:px-10 md:h-24 m-4 rounded-2xl bg-gray-900/80 backdrop-blur-md text-white border border-gray-700/50"
>
  <div class="flex justify-start">
    <a href="/" class="logo shrink-0 md:hidden">
      <Picture
        src={logoMobile}
        alt="RC Technology"
        width={48}
        height={48}
        formats={['webp', 'png']}
      />
    </a>
    <a href="/" class="logo shrink-0 hidden md:block">
      <Picture
        src={logo}
        alt="RC Technology"
        width={250}
        height={80}
        formats={['webp', 'png']}
        class="h-16 w-auto object-contain"
      />
    </a>
  </div>

  <nav
    class="hidden md:flex justify-center items-center gap-4 text-lg font-medium"
  >
    <a href="/" class="hover:text-red-500 transition-colors px-4 py-2">Inicio</a
    >
    <a href="#aboutus" class="hover:text-red-500 transition-colors px-4 py-2"
      >Acerca de</a
    >
    <a href="#form" class="hover:text-red-500 transition-colors px-4 py-2"
      >Contacto</a
    >
  </nav>

  <div class="flex gap-4 items-center justify-end">
    <Button
      as="a"
      href="http://54.37.38.27/"
      id="redbeatbutton"
      class="border border-red-700 hover:bg-red-700/20 px-5 py-2.5 rounded-xl hidden lg:block transition-all"
      text="REDBEAT"
    />
    <Button
      as="a"
      href="#form"
      class="bg-red-700 hover:bg-red-800 px-6 py-2.5 rounded-xl transition-all shadow-lg shadow-red-900/20"
      text="Contáctanos"
    />
    <button
      id="menu-btn"
      class="md:hidden relative w-8 h-8 flex flex-col justify-around ml-2"
      aria-label="Menú"
    >
      <span class="block w-full h-0.5 bg-white transition-all duration-300"
      ></span>
      <span class="block w-full h-0.5 bg-white transition-all duration-300"
      ></span>
      <span class="block w-full h-0.5 bg-white transition-all duration-300"
      ></span>
    </button>
  </div>
</header>

<nav
  id="mobile-menu"
  class="md:hidden fixed top-0 left-0 h-full w-4/5 max-w-xs bg-gray-900/95 backdrop-blur-xl text-white z-[100] transform -translate-x-full transition-transform duration-300 ease-in-out shadow-2xl p-8"
>
  <div class="flex flex-col gap-6 mt-10">
    <a href="/" class="text-2xl font-semibold border-b border-gray-800 pb-4"
      >Inicio</a
    >
    <a
      href="#aboutus"
      class="text-2xl font-semibold border-b border-gray-800 pb-4">Acerca de</a
    >
    <a href="#form" class="text-2xl font-semibold border-b border-gray-800 pb-4"
      >Contacto</a
    >
    <a
      href="http://54.37.38.27/"
      class="text-2xl font-semibold text-red-500"
      target="_blank"
      rel="noopener noreferrer">Plataforma REDBEAT</a
    >
  </div>
</nav>

<style>
  #menu-btn span {
    transform-origin: center;
  }
</style>
