---
import Button from './Button.astro';
import { Picture } from 'astro:assets';
import logo from '../assets/rctlogo.png';
import logoMobile from '../assets/rctlogo_mobile.png';
import LanguageSelector from './LanguageSelector.astro';
import { t } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

const locale: Locale = Astro.locals.locale ?? 'es';
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 grid grid-cols-2 lg:grid-cols-[auto_1fr_auto] items-center px-5 py-4 md:px-10 md:h-24 m-4 rounded-2xl bg-gray-900/80 backdrop-blur-md text-white border border-gray-700/50 z-[120] transition-all duration-500 ease-in-out justify-center"
>
  <div
    id="header-logo"
    class="flex items-center justify-start transition-all duration-500 origin-left"
  >
    <a href="/#hero" class="logo shrink-0 xl:hidden flex items-center">
      <Picture
        src={logoMobile}
        alt="RC Technology"
        width={40}
        height={40}
        formats={['webp', 'png']}
        class="rounded"
      />
    </a>
    <a href="/#hero" class="logo shrink-0 hidden xl:flex items-center">
      <Picture
        src={logo}
        alt="RC Technology"
        width={140}
        height={44}
        formats={['webp', 'png']}
        class="h-11 w-auto object-contain rounded transition-all duration-500"
      />
    </a>
  </div>

  <nav
    id="header-nav"
    class="hidden lg:flex place-self-center justify-center items-center gap-1 text-lg font-medium transition-all duration-500 origin-center xl:pl-36"
  >
    <a
      href="/#hero"
      class="relative px-3 xl:px-5 py-2 text-white/80 hover:text-brand-500 transition-colors duration-300 after:absolute after:bottom-1 after:left-1/2 after:-translate-x-1/2 after:w-0 after:h-0.5 after:bg-brand-500 after:rounded-full after:transition-all after:duration-300 hover:after:w-3/4"
      >{t(locale, 'nav.home')}</a
    >
    <a
      href="/#aboutus"
      class="relative px-3 xl:px-5 py-2 text-white/80 hover:text-brand-500 transition-colors duration-300 after:absolute after:bottom-1 after:left-1/2 after:-translate-x-1/2 after:w-0 after:h-0.5 after:bg-brand-500 after:rounded-full after:transition-all after:duration-300 hover:after:w-3/4"
      >{t(locale, 'nav.about')}</a
    >
    <a
      href="/#contact"
      class="relative px-3 xl:px-5 py-2 text-white/80 hover:text-brand-500 transition-colors duration-300 after:absolute after:bottom-1 after:left-1/2 after:-translate-x-1/2 after:w-0 after:h-0.5 after:bg-brand-500 after:rounded-full after:transition-all after:duration-300 hover:after:w-3/4"
      >{t(locale, 'nav.contact')}</a
    >
  </nav>

  <div
    id="header-actions"
    class="flex gap-2 items-center justify-end transition-all duration-500 origin-right"
  >
    <LanguageSelector />

    <div class="relative hidden lg:inline-block group z-[200]">
      <button
        id="redbeat-btn"
        class="border border-brand-500 hover:bg-brand-500/20 px-3 py-2.5 md:px-4 lg:px-5 rounded text-sm lg:text-base transition-all items-center inline-flex gap-1.5"
      >
        <span>REDBEAT</span>
        <svg class="w-3 h-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <div
        id="redbeat-dropdown"
        class="absolute right-0 top-full mt-1 w-48 rounded-xl border border-white/10 bg-gray-900/95 backdrop-blur-xl shadow-2xl opacity-0 translate-y-[-8px] transition-all duration-200 ease-out"
      >
        <a
          href="https://redbeat.stackcode.io/#/authentication/signin"
          class="block w-full text-left px-4 py-3.5 transition-colors hover:bg-white/10 first:rounded-t-xl text-base font-semibold"
        >
          REDBEAT 1.0
        </a>
        <a
          href="http://54.37.38.27/"
          class="block w-full text-left px-4 py-3.5 transition-colors hover:bg-white/10 last:rounded-b-xl text-base font-semibold"
        >
          REDBEAT 2.0
        </a>
      </div>
    </div>

    <Button
      as="a"
      href="/#contact"
      class="bg-brand-500 hover:bg-brand-600 px-3 py-2 xs:px-6 xs:py-2.5 rounded-xl transition-all shadow-lg shadow-brand-800/20 text-sm xs:text-base"
      text={t(locale, 'nav.contact_btn')}
    />

    <button
      id="menu-btn"
      class="lg:hidden relative w-6 sm:w-8 h-6 sm:h-8 flex flex-col justify-around z-[130] cursor-pointer"
      aria-label="Menú"
    >
      <span class="block w-full h-0.5 bg-white transition-all duration-300"
      ></span>
      <span class="block w-full h-0.5 bg-white transition-all duration-300"
      ></span>
      <span class="block w-full h-0.5 bg-white transition-all duration-300"
      ></span>
    </button>
  </div>
</header>

<nav
  id="mobile-menu"
  class="lg:hidden fixed top-0 left-0 h-screen w-4/5 max-w-xs bg-black/60 backdrop-blur-2xl border-r border-white/10 text-white z-[150] transform -translate-x-full transition-transform duration-300 ease-in-out p-8 shadow-2xl"
>
  <div class="flex flex-col gap-6 mt-24">
    <a
      href="/#hero"
      class="text-2xl font-semibold border-b border-white/10 pb-4">{t(locale, 'mobile_menu.home')}</a
    >
    <a
      href="/#aboutus"
      class="text-2xl font-semibold border-b border-white/10 pb-4">{t(locale, 'mobile_menu.about')}</a
    >
    <a
      href="/#contact"
      class="text-2xl font-semibold border-b border-white/10 pb-4">{t(locale, 'mobile_menu.contact')}</a
    >
    <div class="border-b border-white/10 pb-4">
      <button
        id="mobile-redbeat-btn"
        class="text-2xl font-semibold w-full text-left flex items-center justify-between"
      >
        {t(locale, 'mobile_menu.platform')}
        <svg class="w-4 h-4 transition-transform duration-200" id="mobile-redbeat-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <div
        id="mobile-redbeat-submenu"
        class="mt-3 space-y-2 overflow-hidden max-h-0 opacity-0 transition-all duration-300 ease-in-out"
      >
        <a
          href="https://redbeat.stackcode.io/#/authentication/signin"
          class="block text-lg font-semibold text-brand-500 pl-4 py-2 hover:bg-white/5 rounded-lg transition-colors"
        >
          REDBEAT 1.0
        </a>
        <a
          href="http://54.37.38.27/"
          class="block text-lg font-semibold text-brand-500 pl-4 py-2 hover:bg-white/5 rounded-lg transition-colors"
        >
          REDBEAT 2.0
        </a>
      </div>
    </div>
  </div>
</nav>

<style>
  #menu-btn span {
    transform-origin: center;
  }
  #menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(7px, 7px);
  }
  #menu-btn.active span:nth-child(2) {
    opacity: 0;
  }
  #menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }
  #mobile-menu.open {
    transform: translateX(0);
  }

  #main-header.header-hidden {
    top: -200px;
  }

  #redbeat-dropdown.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  #redbeat-dropdown {
    pointer-events: none;
  }

  #mobile-redbeat-submenu.open {
    max-height: 200px;
    opacity: 1;
  }
  #mobile-redbeat-arrow.rotated {
    transform: rotate(180deg);
  }
</style>

<script>
  const initHeader = () => {
    const header = document.getElementById('main-header');
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const logo = document.getElementById('header-logo');
    const nav = document.getElementById('header-nav');
    const actions = document.getElementById('header-actions');

    // Redbeat dropdown (desktop)
    const redbeatBtn = document.getElementById('redbeat-btn');
    const redbeatDropdown = document.getElementById('redbeat-dropdown');
    const closeLang = () => {
      const lb = document.getElementById('lang-dropdown');
      const lbBtn = document.getElementById('lang-btn');
      if (lb) lb.classList.remove('show');
      if (lbBtn) lbBtn.classList.remove('group-open');
    };

    if (redbeatBtn && redbeatDropdown) {
      redbeatBtn.onclick = (e) => {
        e.stopPropagation();
        closeLang();
        redbeatDropdown.classList.toggle('show');
        redbeatBtn.classList.toggle('group-open');
      };
      document.addEventListener('click', () => {
        redbeatDropdown.classList.remove('show');
        redbeatBtn.classList.remove('group-open');
      });
      redbeatDropdown.onclick = (e) => e.stopPropagation();
    }

    // Redbeat submenu (mobile)
    const mobileRedbeatBtn = document.getElementById('mobile-redbeat-btn');
    const mobileRedbeatSub = document.getElementById('mobile-redbeat-submenu');
    const mobileRedbeatArrow = document.getElementById('mobile-redbeat-arrow');
    if (mobileRedbeatBtn && mobileRedbeatSub) {
      mobileRedbeatBtn.onclick = (e) => {
        e.stopPropagation();
        mobileRedbeatSub.classList.toggle('open');
        mobileRedbeatArrow?.classList.toggle('rotated');
      };
    }

    // Lógica del Menú Móvil
    if (menuBtn && mobileMenu) {
      const toggleMenu = () => {
        menuBtn.classList.toggle('active');
        mobileMenu.classList.toggle('open');
        document.body.classList.toggle('overflow-hidden');
      };

      menuBtn.onclick = (e) => {
        e.stopPropagation();
        toggleMenu();
      };

      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.onclick = toggleMenu;
      });
    }

    // Lógica de Scroll y Centrado
    if (header) {
      let lastScroll = 0;

      window.addEventListener('scroll', () => {
        const currentScroll = window.scrollY;
        const isScrollingDown = currentScroll > lastScroll;
        const isSmall = window.innerWidth < 768;

        // Ocultar header al bajar, mostrar al subir
        if (currentScroll > 100) {
          if (isScrollingDown) {
            header.classList.add('header-hidden');
          } else if (currentScroll < lastScroll) {
            header.classList.remove('header-hidden');
          }
        } else {
          header.classList.remove('header-hidden');
        }

        // Lógica de encogimiento en móvil
        const isScrolled = currentScroll > 50;
        const scaleClass = 'scale-[0.85]';

        if (!isSmall) {
          header.classList.add('md:h-24', 'py-4');
          header.classList.remove('h-16', 'md:h-16', 'py-0');

          logo?.classList.remove(scaleClass);
          nav?.classList.remove(scaleClass);
          actions?.classList.remove(scaleClass);
          lastScroll = currentScroll;
          return;
        }

        if (isScrolled) {
          header.classList.remove('md:h-24', 'py-4');
          header.classList.add('h-16', 'md:h-16', 'py-0', 'items-center');

          logo?.classList.add(scaleClass);
          nav?.classList.add(scaleClass);
          actions?.classList.add(scaleClass);
        } else {
          header.classList.add('md:h-24', 'py-4');
          header.classList.remove('h-16', 'md:h-16', 'py-0');

          logo?.classList.remove(scaleClass);
          nav?.classList.remove(scaleClass);
          actions?.classList.remove(scaleClass);
        }

        lastScroll = currentScroll;
      });
    }
  };

  initHeader();
  // Reiniciar tras navegación en Astro
  document.addEventListener('astro:after-swap', initHeader);
</script>
