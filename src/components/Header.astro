---
import Button from './Button.astro';
import { Picture } from 'astro:assets';
import logo from '../assets/rctlogo.png';
import logoMobile from '../assets/rctlogo_mobile.png';
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 grid grid-cols-2 lg:grid-cols-[auto_1fr_auto] items-center px-5 py-4 md:px-10 md:h-24 m-4 rounded-2xl bg-gray-900/80 backdrop-blur-md text-white border border-gray-700/50 z-[120] transition-all duration-500 ease-in-out justify-center"
>
  <div
    id="header-logo"
    class="flex items-center justify-start transition-all duration-500 origin-left"
  >
    <a href="/#hero" class="logo shrink-0 xl:hidden flex items-center">
      <Picture
        src={logoMobile}
        alt="RC Technology"
        width={48}
        height={48}
        formats={['webp', 'png']}
      />
    </a>
    <a href="/#hero" class="logo shrink-0 hidden xl:flex items-center">
      <Picture
        src={logo}
        alt="RC Technology"
        width={250}
        height={80}
        formats={['webp', 'png']}
        class="h-16 w-auto object-contain transition-all duration-500"
      />
    </a>
  </div>

  <nav
    id="header-nav"
    class="hidden lg:flex place-self-center justify-center items-center gap-4 text-lg font-medium transition-all duration-500 origin-center xl:pl-36"
  >
    <a
      href="/#hero"
      class="hover:text-red-500 transition-colors lg:px-4 xl:px-8 py-2"
      >Inicio</a
    >
    <a
      href="/#aboutus"
      class="hover:text-red-500 transition-colors lg:px-4 xl:px-8 py-2"
      >Sobre Nosotros</a
    >
    <a
      href="/#contact"
      class="hover:text-red-500 transition-colors lg:px-4 xl:px-8">Contacto</a
    >
  </nav>

  <div
    id="header-actions"
    class="flex gap-4 items-center justify-end transition-all duration-500 origin-right"
  >
    <a
      href="https://redbeat.stackcode.io/#/authentication/signin"
      class="border border-red-700 hover:bg-red-700/20 hidden lg:inline-flex px-3 py-2.5 md:px-4 lg:px-5 rounded-lg text-sm lg:text-base transition-all items-center justify-center"
    >
      <span class="hidden lg:inline">REDBEAT 1.0</span>
    </a>

    <a
      href="http://54.37.38.27/"
      class="border border-red-700 hover:bg-red-700/20 hidden lg:inline-flex px-3 py-2.5 md:px-4 lg:px-5 rounded-lg text-sm lg:text-base transition-all items-center justify-center"
    >
      <span class="hidden lg:inline">REDBEAT 2.0</span>
    </a>

    <Button
      as="a"
      href="/#contact"
      class="bg-red-700 hover:bg-red-800 px-3 py-2 xs:px-6 xs:py-2.5 rounded-xl transition-all shadow-lg shadow-red-900/20 text-sm xs:text-base"
      text="Contáctanos"
    />

    <button
      id="menu-btn"
      class="lg:hidden relative w-6 sm:w-8 h-6 sm:h-8 flex flex-col justify-around z-[130] cursor-pointer"
      aria-label="Menú"
    >
      <span class="block w-full h-0.5 bg-white transition-all duration-300"
      ></span>
      <span class="block w-full h-0.5 bg-white transition-all duration-300"
      ></span>
      <span class="block w-full h-0.5 bg-white transition-all duration-300"
      ></span>
    </button>
  </div>
</header>

<nav
  id="mobile-menu"
  class="lg:hidden fixed top-0 left-0 h-screen w-4/5 max-w-xs bg-black/60 backdrop-blur-2xl border-r border-white/10 text-white z-[150] transform -translate-x-full transition-transform duration-300 ease-in-out p-8 shadow-2xl"
>
  <div class="flex flex-col gap-6 mt-24">
    <a
      href="/#hero"
      class="text-2xl font-semibold border-b border-white/10 pb-4">Inicio</a
    >
    <a
      href="/#aboutus"
      class="text-2xl font-semibold border-b border-white/10 pb-4">Acerca de</a
    >
    <a
      href="/#contact"
      class="text-2xl font-semibold border-b border-white/10 pb-4">Contacto</a
    >
    <a
      href="https://redbeat.stackcode.io/#/authentication/signin"
      class="text-2xl font-semibold border-b border-white/10 pb-4"
    >
      Plataforma <span class="text-xl font-bold text-red-500 pt-4"
        >REDBEAT 1.0</span
      >
    </a>
    <a
      href="http://54.37.38.27/"
      class="text-2xl font-semibold border-b border-white/10 pb-4"
    >
      Plataforma <span class="text-xl font-bold text-red-500 pt-4"
        >REDBEAT 2.0</span
      >
    </a>
  </div>
</nav>

<style>
  #menu-btn span {
    transform-origin: center;
  }
  #menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(7px, 7px);
  }
  #menu-btn.active span:nth-child(2) {
    opacity: 0;
  }
  #menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }
  #mobile-menu.open {
    transform: translateX(0);
  }

  #main-header.header-hidden {
    top: -200px;
  }
</style>

<script>
  const initHeader = () => {
    const header = document.getElementById('main-header');
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const logo = document.getElementById('header-logo');
    const nav = document.getElementById('header-nav');
    const actions = document.getElementById('header-actions');

    // Lógica del Menú Móvil
    if (menuBtn && mobileMenu) {
      const toggleMenu = () => {
        menuBtn.classList.toggle('active');
        mobileMenu.classList.toggle('open');
        document.body.classList.toggle('overflow-hidden');
      };

      menuBtn.onclick = (e) => {
        e.stopPropagation();
        toggleMenu();
      };

      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.onclick = toggleMenu;
      });
    }

    // Lógica de Scroll y Centrado
    if (header) {
      let lastScroll = 0;

      window.addEventListener('scroll', () => {
        const currentScroll = window.scrollY;
        const isScrollingDown = currentScroll > lastScroll;
        const isSmall = window.innerWidth < 768;

        // Ocultar header al bajar, mostrar al subir
        if (currentScroll > 100) {
          if (isScrollingDown) {
            header.classList.add('header-hidden');
          } else if (currentScroll < lastScroll) {
            header.classList.remove('header-hidden');
          }
        } else {
          header.classList.remove('header-hidden');
        }

        // Lógica de encogimiento en móvil
        const isScrolled = currentScroll > 50;
        const scaleClass = 'scale-[0.85]';

        if (!isSmall) {
          header.classList.add('md:h-24', 'py-4');
          header.classList.remove('h-16', 'md:h-16', 'py-0');

          logo?.classList.remove(scaleClass);
          nav?.classList.remove(scaleClass);
          actions?.classList.remove(scaleClass);
          lastScroll = currentScroll;
          return;
        }

        if (isScrolled) {
          header.classList.remove('md:h-24', 'py-4');
          header.classList.add('h-16', 'md:h-16', 'py-0', 'items-center');

          logo?.classList.add(scaleClass);
          nav?.classList.add(scaleClass);
          actions?.classList.add(scaleClass);
        } else {
          header.classList.add('md:h-24', 'py-4');
          header.classList.remove('h-16', 'md:h-16', 'py-0');

          logo?.classList.remove(scaleClass);
          nav?.classList.remove(scaleClass);
          actions?.classList.remove(scaleClass);
        }

        lastScroll = currentScroll;
      });
    }
  };

  initHeader();
  // Reiniciar tras navegación en Astro
  document.addEventListener('astro:after-swap', initHeader);
</script>
