---
import { Image } from 'astro:assets';
---

<div class="flex flex-row justify-center gap-2 mb-2">
  <Image
    src="/src/assets/sponsors/logo_accio.avif"
    alt="Logo Accio"
    class="filter brightness-75 sepia-[0.5] hue-rotate-[190deg] contrast-[1.2] hover:brightness-100 transition duration-300 object-contain"
    format="avif"
    width={128}
    height={64}
    class="md:w-[192px] md:h-[76px]"
  />
  <Image
    src="/src/assets/sponsors/logo_cdti.avif"
    alt="Logo CDTI"
    class="filter brightness-75 sepia-[0.5] hue-rotate-[190deg] contrast-[1.2] hover:brightness-100 transition duration-300 object-contain"
    format="avif"
    width={128}
    height={64}
    class="md:w-[192px] md:h-[76px]"
  />
</div>
<div class="flex justify-center">
  <Image
    src="/src/assets/sponsors/logo_enisa.avif"
    alt="Logo Enisa"
    class="filter brightness-75 sepia-[0.5] hue-rotate-[190deg] contrast-[1.2] hover:brightness-100 transition duration-300 object-contain"
    format="avif"
    width={256}
    height={76}
    class="md:w-[400px] md:h-[50px]"
  />
</div>
