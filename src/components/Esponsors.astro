---
import { Image } from 'astro:assets';
import logoAccio from '../assets/sponsors/logo_accio.webp';
import logoCdti from '../assets/sponsors/logo_cdti.webp';
import logoEnisa from '../assets/sponsors/logo_enisa.webp';

const isMobile = true;
---

<div class="flex flex-row justify-center gap-2 mb-2">
  <Image
    src={logoAccio}
    alt="Logo Accio"
    format="webp"
    class="w-[140px] h-auto sm:w-[200px] md:w-[240px]"
  />
  <Image
    src={logoCdti}
    alt="Logo CDTI"
    format="webp"
    class="w-[100px] h-auto sm:w-[150px] md:w-[192px]"
  />
</div>

<div class="flex justify-center">
  <Image
    src={logoEnisa}
    alt="Logo Enisa"
    format="webp"
    class="w-[200px] h-auto sm:w-[300px] md:w-[400px]"
  />
</div>
