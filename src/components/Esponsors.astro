---
import { Image } from 'astro:assets';
import logoAccio from '../assets/sponsors/logo_accio.avif';
import logoCdti from '../assets/sponsors/logo_cdti.avif';
import logoEnisa from '../assets/sponsors/logo_enisa.avif';
---

<div class="flex flex-row justify-center gap-2 mb-2">
  <Image
    src={logoAccio}
    alt="Logo Accio"
    format="avif"
    width={128}
    height={64}
    class="filter brightness-75 sepia-[0.5] hue-rotate-[190deg] contrast-[1.2] hover:brightness-100 transition duration-300 object-contain md:w-[192px] md:h-[76px]"
  />
  <Image
    src={logoCdti}
    alt="Logo CDTI"
    format="avif"
    width={128}
    height={64}
    class="filter brightness-75 sepia-[0.5] hue-rotate-[190deg] contrast-[1.2] hover:brightness-100 transition duration-300 object-contain md:w-[192px] md:h-[76px]"
  />
</div>

<div class="flex justify-center">
  <Image
    src={logoEnisa}
    alt="Logo Enisa"
    format="avif"
    width={256}
    height={76}
    class="filter brightness-75 sepia-[0.5] hue-rotate-[190deg] contrast-[1.2] hover:brightness-100 transition duration-300 object-contain md:w-[400px] md:h-[50px]"
  />
</div>
