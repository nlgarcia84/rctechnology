---
import { actions } from 'astro:actions';
// Aquí solo dejamos lógica de servidor si fuera necesaria
---

<form
  method="POST"
  action={actions.enviarContacto}
  id="form-contacto"
  class="bg-gray-900/50 rounded-xl shadow-md p-8 mb-5 max-w-lg mx-auto flex flex-col gap-7 border-2 border-gray-700"
>
  <div class="flex flex-col gap-1.5">
    <label for="name" class="text-white">Nombre</label>
    <input
      type="text"
      id="name"
      name="name"
      class="w-full p-2 rounded border border-gray-700 bg-gray-800 text-white"
      placeholder="Ingrese su nombre"
      required
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="surname" class="text-white">Apellido</label>
    <input
      type="text"
      id="surname"
      name="surname"
      class="w-full p-2 rounded border border-gray-700 bg-gray-800 text-white"
      placeholder="Ingrese su apellido"
      required
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="email" class="text-white">Correo Electrónico</label>
    <input
      type="email"
      id="email"
      name="email"
      class="w-full p-2 rounded border border-gray-700 bg-gray-800 text-white"
      placeholder="Ingrese su correo electrónico"
      required
    />
  </div>

  <div class="flex flex-col gap-1.5">
    <label for="message" class="text-white">Mensaje</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class="w-full p-2 rounded border border-gray-700 bg-gray-800 text-white"
      placeholder="Escriba su mensaje"
      required></textarea>
  </div>

  <div class="flex flex-col gap-1.5">
    <label class="text-white flex items-center gap-2 cursor-pointer">
      <input type="checkbox" id="terms-checkbox" class="w-4 h-4" />
      <span
        >Acepto la <a href="/politica-privacidad/" class="underline"
          >Política de Privacidad</a
        ></span
      >
    </label>
  </div>

  <button
    id="submit-button"
    type="submit"
    class="bg-red-600 hover:bg-red-700 text-white font-semibold py-3 rounded-lg disabled:opacity-50 disabled:cursor-not-allowed transition-all"
    disabled
  >
    Enviar
  </button>

  <div
    id="form-message"
    class="mt-4 text-center text-sm min-h-[20px] flex items-center justify-center gap-2"
  >
  </div>
</form>

<script>
  // IMPORTANTE: Importamos Lucide y las Actions dentro del script del cliente
  import { createIcons, LoaderCircle } from 'lucide';
  import { actions } from 'astro:actions';

  const form = document.querySelector<HTMLFormElement>('#form-contacto');
  const checkbox = document.querySelector<HTMLInputElement>('#terms-checkbox');
  const submitButton =
    document.querySelector<HTMLButtonElement>('#submit-button');
  const formMessage = document.querySelector<HTMLDivElement>('#form-message');

  // 1. Manejo del estado del botón
  const updateButtonState = () => {
    if (submitButton && checkbox) {
      submitButton.disabled = !checkbox.checked;
    }
  };

  checkbox?.addEventListener('change', updateButtonState);
  updateButtonState(); // Sincronización inicial

  // 2. Manejo del envío
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!formMessage || !submitButton) return;

    // Estado de carga
    submitButton.disabled = true;
    formMessage.innerHTML =
      '<i data-lucide="loader-circle" class="animate-spin"></i> Enviando...';
    formMessage.className =
      'mt-4 text-center text-sm text-blue-400 flex items-center justify-center gap-2';

    // Renderizamos el icono de carga recién insertado
    createIcons({ icons: { LoaderCircle } });

    try {
      const formData = new FormData(form);
      // USAMOS LA ACCIÓN REAL DE ASTRO
      const { data, error } = await actions.enviarContacto(formData);

      if (error) {
        throw new Error('Error al enviar');
      }

      formMessage.textContent = '¡Mensaje enviado con éxito!';
      formMessage.className = 'mt-4 text-center text-sm text-green-500';
      form.reset(); // Limpiar formulario
      updateButtonState();
    } catch (err) {
      formMessage.textContent = 'Hubo un error. Inténtalo de nuevo.';
      formMessage.className = 'mt-4 text-center text-sm text-red-500';
      submitButton.disabled = false;
    } finally {
      setTimeout(() => {
        formMessage.textContent = '';
      }, 5000);
    }
  });
</script>
