---
import { actions } from 'astro:actions';
let isChecked = false;

function handleCheckboxChange(event: Event) {
  const target = event.target as HTMLInputElement;
  isChecked = target.checked;
}
---

<form
  method="POST"
  action={actions.enviarContacto}
  id="form"
  class="bg-gray-900/50 rounded-xl shadow-md p-8 mb-5 max-w-lg mx-auto flex flex-col gap-7 border-2 border-gray-700"
>
  <div class="flex flex-col gap-1.5">
    <label for="name" class="text-white">Nombre</label>
    <input
      required
      type="text"
      name="name"
      id="name"
      class="border border-gray-700 rounded-lg px-4 py-2.5 bg-gray-900 text-white"
      placeholder="Su nombre"
      autocomplete="off"
    />
  </div>
  <div class="flex flex-col gap-1.5">
    <label for="surname" class="text-white">Apellido</label>
    <input
      required
      type="text"
      name="surname"
      id="surname"
      class="border border-gray-700 rounded-lg px-4 py-2.5 bg-gray-900 text-white"
      placeholder="Su apellido"
      autocomplete="off"
    />
  </div>
  <div class="flex flex-col gap-1.5">
    <label for="email" class="text-white">Correo Electrónico</label>
    <input
      required
      type="email"
      name="email"
      id="email"
      class="border border-gray-700 rounded-lg px-4 py-2.5 bg-gray-900 text-white"
      placeholder="correu@exemple.com"
      autocomplete="off"
    />
  </div>
  <div class="flex flex-col gap-1.5">
    <label for="message" class="text-white">Mensaje</label>
    <textarea
      required
      name="message"
      id="message"
      rows="4"
      class="border border-gray-700 rounded-lg px-4 py-2.5 bg-gray-900 text-white"
      placeholder="En què et podem ajudar?"
      autocomplete="off"></textarea>
  </div>
  <label>
    <input type="checkbox" on:change={handleCheckboxChange} />
    Acepto la <a href="/politica-privacidad/">Política de Privacidad</a>.
  </label>
  <button
    type="submit"
    class={`bg-red-600 hover:bg-red-700 text-white font-semibold py-2.5 rounded-lg transition ${!isChecked ? 'opacity-50 cursor-not-allowed' : ''}`}
    disabled={!isChecked}
  >
    Enviar
  </button>
</form>
