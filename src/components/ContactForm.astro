---
import formimage from '../assets/formimage.png';
import Picture from 'astro/components/Picture.astro';

interface Props {
  action?: any;
}

const { action } = Astro.props;
---

<div class="relative w-full bg-gray-950">
  <!-- CONTENEDOR HERO -->
  <div class="relative min-h-[85vh] w-full flex justify-center">
    <!-- IMAGEN -->
    <Picture
      src={formimage}
      alt="Imagen formulario"
      formats={['webp', 'png']}
      class="absolute inset-0 w-full h-full object-cover z-0"
    />

    <!-- TINTE BASE -->
    <div class="absolute inset-0 bg-gray-950/60 z-10"></div>

    <!-- VIGNETTE -->
    <div
      class="absolute inset-0 z-20"
      style="background: radial-gradient(circle, transparent 0%, #030712 95%);"
    >
    </div>

    <!-- DEGRADADOS -->
    <div
      class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-gray-950 to-transparent z-30"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-gray-950 to-transparent z-30"
    >
    </div>
    <div
      class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-gray-950 to-transparent z-30"
    >
    </div>
    <div
      class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-gray-950 to-transparent z-30"
    >
    </div>

    <!-- FORM OVERLAY -->
    <div
      class="relative z-40 w-full px-4 py-6 sm:py-10 flex flex-col items-center"
    >
      <form
        method="POST"
        action={action}
        id="form-contacto"
        class="w-full max-w-lg
           bg-gray-900/30
           backdrop-blur-2xl
           rounded-2xl
           shadow-[0_20px_80px_rgba(0,0,0,0.6)]
           border border-white/10
            p-6 sm:p-8
            flex flex-col gap-6
            hover:scale-100 transition-all duration-300"
      >
        <div class="flex flex-col gap-1.5">
          <label for="form-name" class="text-white/90 text-sm">Nombre</label>
          <input
            id="form-name"
            type="text"
            name="name"
            class="w-full p-2 rounded-lg bg-gray-800/70 border border-white/10 text-white focus:outline-none focus:border-red-500"
            required
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="form-surname" class="text-white/90 text-sm"
            >Apellido</label
          >
          <input
            id="form-surname"
            type="text"
            name="surname"
            class="w-full p-2 rounded-lg bg-gray-800/70 border border-white/10 text-white focus:outline-none focus:border-red-500"
            required
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="form-email" class="text-white/90 text-sm"
            >Correo Electrónico</label
          >
          <input
            id="form-email"
            type="email"
            name="email"
            class="w-full p-2 rounded-lg bg-gray-800/70 border border-white/10 text-white focus:outline-none focus:border-red-500"
            required
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="form-message-input" class="text-white/90 text-sm">Mensaje</label
          >
          <textarea
            id="form-message-input"
            name="message"
            rows="4"
            class="w-full p-2 rounded-lg bg-gray-800/70 border border-white/10 text-white focus:outline-none focus:border-red-500"
            required></textarea>
        </div>

        <label
          for="terms-checkbox"
          class="text-white flex items-center gap-2 text-sm"
        >
          <input
            type="checkbox"
            id="terms-checkbox"
            class="w-4 h-4 accent-red-600"
          />
          <span>
            Acepto la <a
              href="/politica-privacidad/"
              class="underline hover:text-red-400">Política de Privacidad</a
            >
          </span>
        </label>

        <button
          id="submit-button"
          type="submit"
          class="bg-red-600 hover:bg-red-700 text-white font-medium py-3 rounded-xl disabled:opacity-50 transition-all"
          disabled
        >
          Enviar
        </button>

        <div
          id="form-status"
          class="text-center text-sm min-h-[20px] text-white/80"
        >
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  import { actions } from 'astro:actions';

  const termsCheckbox = document.getElementById(
    'terms-checkbox',
  ) as HTMLInputElement | null;
  const submitButton = document.getElementById(
    'submit-button',
  ) as HTMLButtonElement | null;
  const form = document.getElementById(
    'form-contacto',
  ) as HTMLFormElement | null;
  const formStatusElement = document.getElementById(
    'form-status',
  ) as HTMLDivElement | null;

  if (!termsCheckbox || !submitButton || !form || !formStatusElement) {
    throw new Error('Contact form elements were not found.');
  }

  const syncSubmitState = () => {
    submitButton.toggleAttribute('disabled', !termsCheckbox.checked);
  };

  termsCheckbox.addEventListener('change', syncSubmitState);
  syncSubmitState();

  form.addEventListener('submit', async (event) => {
    if (!termsCheckbox.checked) {
      event.preventDefault();
      submitButton.toggleAttribute('disabled', true);
      formStatusElement.textContent =
        'Debes aceptar la política de privacidad.';
      return;
    }

    event.preventDefault();
    submitButton.disabled = true;
    formStatusElement.textContent = 'Enviando...';

    try {
      const formData = new FormData(form);
      const result = await actions.contact(formData);

      if (result.data) {
        formStatusElement.textContent = 'Mensaje enviado con éxito!';
      } else {
        const error = result.error as
          | {
              fields?: Record<string, string[] | undefined>;
              message?: string;
            }
          | undefined;
        const fieldMessages = error?.fields
          ? Object.values(error.fields)
              .flat()
              .filter((message): message is string => Boolean(message))
          : [];

        if (fieldMessages.length > 0) {
          formStatusElement.textContent = fieldMessages.join(' ');
        } else if (error?.message) {
          formStatusElement.textContent = error.message;
        } else {
          formStatusElement.textContent = 'Se produjo un error :(';
        }
      }
    } catch {
      formStatusElement.textContent = 'Se produjo un error :(';
    } finally {
      syncSubmitState();
    }
  });
</script>
