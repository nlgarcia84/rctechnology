---
import { Image } from 'astro:assets';
import logoAccio from '../assets/sponsors/logo_accio.webp';

const isMobile = true;
---

<div class="flex flex-row justify-center gap-2 mb-2">
  <div class="bg-white rounded-lg p-1.5 flex items-center relative overflow-hidden">
    <Image
      src={logoAccio}
      alt="Logo Accio"
      format="webp"
      class="w-[140px] h-auto sm:w-[200px] md:w-[240px]"
    />
    <div class="absolute inset-0 bg-gray-950/20 pointer-events-none"></div>
  </div>
</div>
