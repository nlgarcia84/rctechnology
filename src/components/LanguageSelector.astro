---
import { LOCALES } from '../lib/i18n';
import { t } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

const currentLocale: Locale = Astro.locals.locale ?? 'es';
const locales: Locale[] = LOCALES;
---

<div class="relative inline-block text-sm group z-[200]">
  <button
    id="lang-btn"
    class="flex items-center gap-1.5 px-3 py-2.5 md:px-4 lg:px-5 rounded border border-white/20 text-white/80 hover:text-white hover:border-white/40 transition-all text-sm lg:text-base"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2z"/>
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 12h20M12 2c2.5 3 4 7 4 12s-1.5 9-4 12m0-24c-2.5 3-4 7-4 12s1.5 9 4 12"/>
    </svg>
    <span class="uppercase font-semibold">{currentLocale}</span>
    <svg class="w-3 h-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </button>

  <div
    id="lang-dropdown"
    class="absolute right-0 top-full mt-1 w-36 rounded-xl border border-white/10 bg-gray-900/95 backdrop-blur-xl shadow-2xl opacity-0 translate-y-[-8px] transition-all duration-200 ease-out"
  >
    {locales.map((locale) => (
      <button
        data-locale={locale}
        class={`block w-full text-left px-4 py-3 transition-colors hover:bg-white/10 first:rounded-t-xl last:rounded-b-xl text-base ${locale === currentLocale ? 'text-brand-400 font-semibold' : 'text-white/80'}`}
      >
        {t(locale, `lang.${locale}`)}
      </button>
    ))}
  </div>
</div>

<style>
  #lang-dropdown.show {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  #lang-dropdown {
    pointer-events: none;
  }
</style>

<script>
  const btn = document.getElementById('lang-btn');
  const dropdown = document.getElementById('lang-dropdown');

  const closeRedbeat = () => {
    const rb = document.getElementById('redbeat-dropdown');
    const rbBtn = document.getElementById('redbeat-btn');
    if (rb) rb.classList.remove('show');
    if (rbBtn) rbBtn.classList.remove('group-open');
  };

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeRedbeat();
    dropdown?.classList.toggle('show');
    btn?.classList.toggle('group-open');
  });

  document.addEventListener('click', () => {
    dropdown?.classList.remove('show');
    btn?.classList.remove('group-open');
  });

  dropdown?.querySelectorAll('button[data-locale]').forEach((el) => {
    el.addEventListener('click', () => {
      const locale = el.getAttribute('data-locale');
      if (locale) {
        document.cookie = `locale=${locale}; path=/; max-age=31536000; SameSite=Lax`;
        location.reload();
      }
    });
  });
</script>
