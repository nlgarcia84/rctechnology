---
import { Picture } from 'astro:assets';
import Button from './Button.astro';

interface Props {
  imageUrl: any;
  title: string;
  description: string | string[];
  class?: string;
  paginaDesti: string;
}

const {
  imageUrl,
  title,
  description,
  class: className = '',
  paginaDesti,
} = Astro.props;
---

<div
  data-reveal
  class={`mb-10 mx-auto w-full max-w-[95vw] sm:max-w-[400px] md:max-w-[350px] lg:max-w-[380px] xl:max-w-md  h-500px flex flex-col rounded-lg border border-gray-700 bg-gray-900/50 backdrop-blur-sm transition-all duration-300 hover:border-gray-600 hover:bg-gray-900/80 hover:shadow-lg hover:shadow-brand-500/10 ${className}`}
>
  {
    imageUrl && (
      <Picture
        src={imageUrl}
        alt={title}
        width={480}
        height={270}
        formats={['webp', 'png']}
        class="mb-4 rounded-t-lg w-full h-[160px] sm:h-[180px] md:h-[160px] lg:h-[180px] object-cover"
      />
    )
  }
  <div class="flex-1 flex flex-col p-4 sm:p-5 md:p-5 lg:p-7">
    <h3
      class="mb-3 text-center text-xl font-bold tracking-tight bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent"
    >
      {title}
    </h3>

    <div class="mb-6">
      {
        Array.isArray(description) ? (
          <ul class="list-disc pl-5 text-gray-400 text-sm leading-relaxed line-clamp-4 space-y-1">
            {description.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-400 text-sm leading-relaxed line-clamp-4">
            {description}
          </p>
        )
      }
    </div>

    <Button
      as="a"
      href={paginaDesti}
      text="Leer más"
      class="text-white border-brand-500 bg-brand-500 border rounded-xl px-4 py-2 ml-auto mr-auto"
    />
  </div>

  <style>
    a {
      text-decoration: none;
    }
  </style>
</div>
