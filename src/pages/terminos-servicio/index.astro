---
import Layout from '../../layouts/Layout.astro';
import pkg from 'lucide-react';
import { t } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';
const { Home } = pkg;
const locale: Locale = Astro.locals.locale ?? 'es';
const isHomePage = Astro.url.pathname === '/';
---

<Layout>
  <section
    class="min-h-screen bg-gray-950 text-gray-300 py-12 px-6 sm:px-10 lg:px-20"
  >
    <div
      class="max-w-4xl mx-auto bg-gray-900/50 backdrop-blur-xl border border-white/10 p-8 sm:p-12 rounded-3xl shadow-2xl"
    >
      <header
        class="border-b border-white/10 pb-8 mb-8 flex items-center justify-between gap-4"
      >
        <div>
          <h1 class="text-4xl font-bold text-white mb-2">
            {t(locale, 'legal.terms_title')}
          </h1>
          <p class="text-sm text-gray-400">{t(locale, 'legal.last_update')}</p>
        </div>
        {
          !isHomePage && (
            <a
              href="/#hero"
              id="go-home"
              class="inline-flex items-center gap-2 rounded-xl border border-brand-500/80 bg-gray-900/80 px-4 py-2 text-brand-400 transition-all hover:bg-brand-500/10"
            >
              <Home className="w-5 h-5" />
            </a>
          )
        }
      </header>

      <article
        class="bg-gray-800/40 rounded-2xl p-6 mb-10 border border-white/5"
      >
        <section class="mb-6">
          <h2 class="text-xl font-semibold text-white mb-2">{t(locale, 'legal.terms_section1_title')}</h2>
          <p class="text-sm leading-relaxed">
            {t(locale, 'legal.terms_section1_text')}
          </p>
        </section>

        <section class="mb-6">
          <h2 class="text-xl font-semibold text-white mb-2">{t(locale, 'legal.terms_section2_title')}</h2>
          <p class="text-sm leading-relaxed">
            {t(locale, 'legal.terms_section2_text')}
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-2">
            {t(locale, 'legal.terms_section3_title')}
          </h2>
          <p class="text-sm leading-relaxed">
            {t(locale, 'legal.terms_section3_text')}
          </p>
        </section>
      </article>
    </div>
  </section>
</Layout>
