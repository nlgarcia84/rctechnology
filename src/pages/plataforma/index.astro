---
import MiniCard from '../../components/MiniCard.astro';
import Layout from '../../layouts/Layout.astro';
import pkg from 'lucide-react';
import { t } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';
const { Home } = pkg;
const locale: Locale = Astro.locals.locale ?? 'es';
const isHomePage = Astro.url.pathname === '/';

const data = [
  {
    icon: 'Heart',
    title: t(locale, 'platform.feature1_title'),
    description: t(locale, 'platform.feature1_desc'),
  },
  {
    icon: 'Activity',
    title: t(locale, 'platform.feature2_title'),
    description: t(locale, 'platform.feature2_desc'),
  },
  {
    icon: 'Scale',
    title: t(locale, 'platform.feature3_title'),
    description: t(locale, 'platform.feature3_desc'),
  },
  {
    icon: 'Zap',
    title: t(locale, 'platform.feature4_title'),
    description: t(locale, 'platform.feature4_desc'),
  },
];
---

<Layout>
  <section class="min-h-screen bg-gray-950 text-gray-300 lg:px-20">
    <div
      class="max-w-4xl mx-auto bg-gray-900/50 backdrop-blur-xl border border-white/10 sm:p-12 rounded-3xl shadow-2xl"
    >
      <header
        data-reveal
        class="border-b border-white/10 p-5 mb-8 flex items-center justify-between gap-4"
      >
        <h1 class="text-4xl font-bold text-white mb-0">
          {t(locale, 'platform.title')}
        </h1>
        {
          !isHomePage && (
            <a
              href="/#hero"
              id="go-home"
              class="inline-flex items-center gap-2 rounded-xl border border-brand-500/80 bg-gray-900/80 px-4 py-2 text-brand-400 transition-all hover:bg-brand-500/10"
            >
              <Home className="w-5 h-5" />
            </a>
          )
        }
      </header>

      <article
        data-reveal
        class="bg-gray-800/40 rounded-2xl p-6 mb-10 border border-white/5 m-5"
      >
        <h2 class="text-xl font-semibold text-white mb-4 flex items-center">
          <span class="w-1.5 h-6 bg-brand-500 rounded-full mr-3"></span>
          {t(locale, 'platform.section1_title')}
        </h2>
        <p set:html={t(locale, 'platform.section1_text')}>
        </p>
      </article>

      <article
        data-reveal
        class="bg-gray-800/40 rounded-2xl p-6 mb-10 border border-white/5 m-5"
      >
        <h2 class="text-xl font-semibold text-white mb-4 flex items-center">
          <span class="w-1.5 h-6 bg-brand-500 rounded-full mr-3"></span>
          {t(locale, 'platform.section2_title')}
        </h2>
        <p class="mb-5">
          {t(locale, 'platform.section2_text')}
        </p>
        <ol>
          {
            data.map((d) => (
              <li data-reveal class="bg-gray-800/40 rounded-2xl p-6 mb-10 border border-white/5 m-5">
                <MiniCard
                  icon={d.icon}
                  title={d.title}
                  description={d.description}
                />
              </li>
            ))
          }
        </ol>
      </article>
      <article
        data-reveal
        class="bg-gray-800/40 rounded-2xl p-6 mb-10 border border-white/5 m-5"
      >
        <h2 class="text-xl font-semibold text-white mb-4 flex items-center">
          <span class="w-1.5 h-6 bg-brand-500 rounded-full mr-3"></span>
          {t(locale, 'platform.section3_title')}
        </h2>
        <p set:html={t(locale, 'platform.section3_text')}>
        </p>
      </article>
    </div>
  </section>
</Layout>
