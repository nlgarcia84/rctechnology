---
import MiniCard from '../../components/MiniCard.astro';
import Layout from '../../layouts/Layout.astro';
import pkg from 'lucide-react';
const { Home } = pkg;
const isHomePage = Astro.url.pathname === '/';

const categories = [
  {
    title: 'Seguimiento Diario',
    subtitle: 'Dispositivos que te acompañan siempre.',
    items: [
      {
        icon: 'Watch',
        title: 'RedBeat Watch',
        description:
          'Centro de control en la muñeca para presión arterial, SpO2, frecuencia cardíaca y temperatura.',
      },
      {
        icon: 'HeartPulse',
        title: 'RedBeat Patch',
        description:
          'Parche ECG discreto que detecta arritmias y eventos cardíacos mientras el paciente mantiene su rutina.',
      },
      {
        icon: 'Scale',
        title: 'RedBeat Scale',
        description:
          'Báscula de bioimpedancia para control de peso y líquidos, clave en la prevención de edemas.',
      },
    ],
  },
  {
    title: 'Análisis Avanzado',
    subtitle: 'El laboratorio en tu bolsillo.',
    items: [
      {
        icon: 'FlaskConical',
        title: 'Medidor NT-proBNP',
        description:
          'Análisis de sangre capilar en menos de 10 minutos para diagnóstico y seguimiento de insuficiencia cardíaca.',
      },
      {
        icon: 'Droplets',
        title: 'Medidor Urine Calcium',
        description:
          'Sensor digital para medir calcio en orina y monitorizar la salud renal asociada al riesgo cardiovascular.',
      },
    ],
  },
  {
    title: 'Grado Clínico',
    subtitle: 'Precisión profesional para decisiones médicas.',
    items: [
      {
        icon: 'ScanLine',
        title: 'RedBeat ECG 12 Derivaciones',
        description:
          'Electrocardiógrafo profesional que ofrece una lectura cardiaca completa con calidad hospitalaria.',
      },
      {
        icon: 'Building2',
        title: 'Kiosco RedBeat',
        description:
          'Punto de salud automatizado para cribado rápido de hipertensión y riesgo cardiovascular en farmacias y empresas.',
      },
    ],
  },
];
---

<Layout>
  <section class="min-h-screen bg-gray-950 text-gray-300 lg:px-20 pb-10">
    <div
      class="max-w-7xl mx-auto bg-gray-900/50 backdrop-blur-xl border border-white/10 sm:p-12 rounded-3xl shadow-2xl"
    >
      <header
        data-reveal
        class="border-b border-white/10 p-5 mb-8 flex items-center justify-between gap-4"
      >
        <div>
          <h1 class="text-4xl font-bold text-white mb-2">Tecnología RedBeat</h1>
          <p class="text-gray-300 max-w-4xl">
            El ecosistema RedBeat integra monitorización continua, análisis
            portátil de biomarcadores y soluciones clínicas de alta precisión
            para transformar el seguimiento cardiovascular en una estrategia
            preventiva, conectada y accionable.
          </p>
        </div>
        {
          !isHomePage && (
            <a
              href="/#hero"
              id="go-home"
              class="inline-flex items-center gap-2 rounded-xl border border-red-500/80 bg-gray-900/80 px-4 py-2 text-red-400 transition-all hover:bg-red-500/10"
            >
              <Home className="w-5 h-5" />
            </a>
          )
        }
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 p-5">
        {
          categories.map((category) => (
            <article data-reveal class="bg-gray-800/40 rounded-2xl p-6 border border-white/5">
              <h2 class="text-2xl font-bold text-white mb-2">
                {category.title}
              </h2>
              <p class="text-red-500 font-medium mb-6">{category.subtitle}</p>

              <ol class="space-y-4">
                {category.items.map((item) => (
                  <li data-reveal class="bg-gray-900/60 rounded-xl p-4 border border-white/10">
                    <MiniCard
                      icon={item.icon}
                      title={item.title}
                      description={item.description}
                    />
                  </li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
