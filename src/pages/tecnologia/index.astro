---
import MiniCard from '../../components/MiniCard.astro';
import Layout from '../../layouts/Layout.astro';
import pkg from 'lucide-react';
import { t } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';
const { Home } = pkg;
const locale: Locale = Astro.locals.locale ?? 'es';
const isHomePage = Astro.url.pathname === '/';

const categories = [
  {
    title: t(locale, 'tech.cat1_title'),
    subtitle: t(locale, 'tech.cat1_sub'),
    items: [
      {
        icon: 'Watch',
        title: t(locale, 'tech.item1_title'),
        description: t(locale, 'tech.item1_desc'),
      },
      {
        icon: 'HeartPulse',
        title: t(locale, 'tech.item2_title'),
        description: t(locale, 'tech.item2_desc'),
      },
      {
        icon: 'Scale',
        title: t(locale, 'tech.item3_title'),
        description: t(locale, 'tech.item3_desc'),
      },
    ],
  },
  {
    title: t(locale, 'tech.cat2_title'),
    subtitle: t(locale, 'tech.cat2_sub'),
    items: [
      {
        icon: 'FlaskConical',
        title: t(locale, 'tech.item4_title'),
        description: t(locale, 'tech.item4_desc'),
      },
      {
        icon: 'Droplets',
        title: t(locale, 'tech.item5_title'),
        description: t(locale, 'tech.item5_desc'),
      },
    ],
  },
  {
    title: t(locale, 'tech.cat3_title'),
    subtitle: t(locale, 'tech.cat3_sub'),
    items: [
      {
        icon: 'ScanLine',
        title: t(locale, 'tech.item6_title'),
        description: t(locale, 'tech.item6_desc'),
      },
      {
        icon: 'Building2',
        title: t(locale, 'tech.item7_title'),
        description: t(locale, 'tech.item7_desc'),
      },
    ],
  },
];
---

<Layout>
  <section class="min-h-screen bg-gray-950 text-gray-300 lg:px-20 pb-10">
    <div
      class="max-w-7xl mx-auto bg-gray-900/50 backdrop-blur-xl border border-white/10 sm:p-12 rounded-3xl shadow-2xl"
    >
      <header
        data-reveal
        class="border-b border-white/10 p-5 mb-8 flex items-center justify-between gap-4"
      >
        <div>
          <h1 class="text-4xl font-bold text-white mb-2">{t(locale, 'tech.title')}</h1>
          <p class="text-gray-300 max-w-4xl">
            {t(locale, 'tech.subtitle')}
          </p>
        </div>
        {
          !isHomePage && (
            <a
              href="/#hero"
              id="go-home"
              class="inline-flex items-center gap-2 rounded-xl border border-red-500/80 bg-gray-900/80 px-4 py-2 text-red-400 transition-all hover:bg-red-500/10"
            >
              <Home className="w-5 h-5" />
            </a>
          )
        }
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 p-5">
        {
          categories.map((category) => (
            <article data-reveal class="bg-gray-800/40 rounded-2xl p-6 border border-white/5">
              <h2 class="text-2xl font-bold text-white mb-2">
                {category.title}
              </h2>
              <p class="text-red-500 font-medium mb-6">{category.subtitle}</p>

              <ol class="space-y-4">
                {category.items.map((item) => (
                  <li data-reveal class="bg-gray-900/60 rounded-xl p-4 border border-white/10">
                    <MiniCard
                      icon={item.icon}
                      title={item.title}
                      description={item.description}
                    />
                  </li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
