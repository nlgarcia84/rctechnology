---
import Layout from '../../layouts/Layout.astro';
import pkg from 'lucide-react';
const { Home } = pkg;
const isHomePage = Astro.url.pathname === '/';
---

<Layout>
  <section
    class="min-h-screen bg-gray-950 text-gray-300 py-12 px-6 sm:px-10 lg:px-20"
  >
    <div
      class="max-w-4xl mx-auto bg-gray-900/50 backdrop-blur-xl border border-white/10 p-8 sm:p-12 rounded-3xl shadow-2xl"
    >
      <header
        class="border-b border-white/10 pb-8 mb-8 flex items-center justify-between gap-4"
      >
        <div>
          <h1 class="text-4xl font-bold text-white mb-2">Aviso legal</h1>
          <p class="text-sm text-gray-400">Última actualización: Abril 2026</p>
        </div>
        {
          !isHomePage && (
            <a
              href="/#hero"
              id="go-home"
              class="inline-flex items-center gap-2 rounded-xl border border-red-500/80 bg-gray-900/80 px-4 py-2 text-red-400 transition-all hover:bg-red-500/10"
            >
              <Home className="w-5 h-5" />
            </a>
          )
        }
      </header>

      <article
        class="bg-gray-800/40 rounded-2xl p-6 mb-10 border border-white/5 space-y-6"
      >
        <section>
          <h2 class="text-xl font-semibold text-white mb-2">Identificación</h2>
          <p class="text-sm leading-relaxed">
            RC Technology Solutions SL. CIF: B56360894. Dirección: Gran Vía de
            les Corts Catalanes 620, ático 4A, 08007 Barcelona. Correo: <a
              href="mailto:rafael@rctechnology.es"
              class="underline">rafael@rctechnology.es</a
            >.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-2">Objeto</h2>
          <p class="text-sm leading-relaxed">
            El presente aviso legal regula el acceso, navegación y uso del sitio
            web, así como las responsabilidades derivadas del contenido y de los
            servicios que se facilitan en el mismo.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-2">
            Propiedad intelectual
          </h2>
          <p class="text-sm leading-relaxed">
            Todos los contenidos del sitio, incluyendo textos, imágenes, marcas
            y diseños son propiedad de RC Technology Solutions SL o de terceros
            que han autorizado su uso.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-white mb-2">
            Legislación aplicable
          </h2>
          <p class="text-sm leading-relaxed">
            Las relaciones entre el usuario y RC Technology se regirán por la
            normativa española vigente y cualquier controversia será sometida a
            los tribunales competentes.
          </p>
        </section>
      </article>
    </div>
  </section>
</Layout>
