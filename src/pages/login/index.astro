---
import LoginLayout from '../../layouts/LoginLayout.astro';
---

<LoginLayout>
  <div class="relative w-full bg-gray-950 overflow-hidden">
    <div
      class="relative min-h-screen w-full flex items-center justify-center px-4 py-8"
    >
      <form
        method="POST"
        action="/api/login"
        id="form-login"
        class="w-full max-w-lg
        bg-gray-900/30
        backdrop-blur-2xl
        rounded-2xl
        shadow-[0_20px_80px_rgba(0,0,0,0.6)]
        border border-white/10
        p-6 sm:p-8
        flex flex-col gap-6
        my-8
        hover:scale-100 transition-all duration-300"
      >
        <div class="flex flex-col gap-1.5 text-center">
          <h1 class="text-3xl sm:text-4xl font-semibold text-white pb-5">
            Bienvenido Admin
          </h1>

          <p class="text-white/70 text-sm pb-5">
            Inicia sesión para consultar los contactos.
          </p>
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-white/90 text-sm pb-2 text-center"
            >Correo Electrónico</label
          >
          <input
            type="email"
            name="email"
            class="w-full p-2 rounded-lg bg-gray-800/70 border border-white/10 text-white focus:outline-none focus:border-red-500"
            required
            autocomplete="email"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="text-white/90 text-sm pb-2 text-center"
            >Contraseña</label
          >
          <input
            type="password"
            name="password"
            class="w-full p-2 rounded-lg bg-gray-800/70 border border-white/10 text-white focus:outline-none focus:border-red-500"
            required
            autocomplete="current-password"
          />
        </div>

        <button
          id="submit-button"
          type="submit"
          class="bg-red-600 hover:bg-red-700 text-white font-medium py-3 rounded-xl disabled:opacity-50 transition-all"
        >
          Entrar
        </button>
      </form>
    </div>
  </div>
</LoginLayout>
