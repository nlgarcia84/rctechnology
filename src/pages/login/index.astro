---
import LoginLayout from '../../layouts/LoginLayout.astro';
---

<LoginLayout>
  <div class="relative min-h-screen overflow-hidden bg-[#05070d]">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,_rgba(204,3,42,0.18),_transparent_28%),radial-gradient(circle_at_top_right,_rgba(255,255,255,0.10),_transparent_22%),radial-gradient(circle_at_bottom,_rgba(255,255,255,0.06),_transparent_26%)]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_bottom,rgba(5,7,13,0.1),rgba(5,7,13,0.65))]"
    >
    </div>

    <div
      class="relative min-h-screen w-full px-4 py-10 sm:px-6 flex items-center justify-center"
    >
      <form
        method="POST"
        action="/api/login"
        id="form-login"
        class="w-full max-w-xl rounded-[2rem] border border-white/10 bg-white/6 p-6 sm:p-8 md:p-10 shadow-[0_30px_120px_rgba(0,0,0,0.55)] backdrop-blur-xl"
      >
        <div class="mb-8 flex items-start justify-between gap-4">
          <div>
            <div
              class="inline-flex items-center gap-2 rounded-full border border-brand-500/30 bg-brand-500/10 px-4 py-2 text-[11px] font-medium uppercase tracking-[0.22em] text-brand-200/90"
            >
              Admin Access
            </div>
            <h2
              class="mt-4 text-3xl sm:text-4xl font-semibold tracking-tight text-white"
            >
              Bienvenido Admin
            </h2>
            <p class="mt-3 max-w-xl text-sm leading-6 text-white/65">
              Inicia sesión para consultar los contactos y operar el dashboard
              con acceso seguro.
            </p>
          </div>
          <div
            class="hidden sm:flex h-12 w-12 items-center justify-center rounded-2xl border border-brand-500/25 bg-brand-500/10 text-brand-200 shadow-[0_10px_30px_rgba(204,3,42,0.18)]"
          >
            <span class="text-xl">⌘</span>
          </div>
        </div>

        <div class="space-y-5">
          <div class="flex flex-col gap-2.5">
            <label class="text-sm font-medium text-white/85" for="email"
              >Correo electrónico</label
            >
            <input
              type="email"
              name="email"
              id="email"
              class="w-full rounded-2xl border border-white/10 bg-gray-900/70 px-4 py-3.5 text-white placeholder:text-white/25 outline-none transition focus:border-brand-500/70 focus:bg-gray-900 focus:ring-4 focus:ring-brand-500/10"
              placeholder="admin@rctechnology.es"
              required
              autocomplete="email"
            />
          </div>

          <div class="flex flex-col gap-2.5">
            <label class="text-sm font-medium text-white/85" for="password"
              >Contraseña</label
            >
            <div class="relative">
              <input
                type="password"
                name="password"
                id="password"
                class="w-full rounded-2xl border border-white/10 bg-gray-900/70 px-4 py-3.5 pr-12 text-white placeholder:text-white/25 outline-none transition focus:border-brand-500/70 focus:bg-gray-900 focus:ring-4 focus:ring-brand-500/10"
                placeholder="Introduce tu contraseña"
                required
                autocomplete="current-password"
              />
              <button
                type="button"
                id="toggle-password"
                class="absolute inset-y-0 right-0 flex items-center justify-center px-4 text-white/45 transition hover:text-white"
                aria-label="Mostrar u ocultar contraseña"
                aria-pressed="false"
              >
                <span id="toggle-password-icon" class="text-sm">👁</span>
              </button>
            </div>
          </div>
        </div>

        <div
          class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
        >
          <p class="text-xs leading-5 text-white/45">
            Acceso restringido al equipo autorizado.
          </p>
          <button
            id="submit-button"
            type="submit"
            class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-brand-600 to-brand-500 px-6 py-3 font-medium text-white shadow-[0_18px_40px_rgba(204,3,42,0.26)] transition hover:translate-y-[-1px] hover:from-brand-500 hover:to-brand-400 active:translate-y-0 disabled:opacity-50"
          >
            Entrar
          </button>
        </div>
      </form>
    </div>
  </div>
</LoginLayout>

<script>
  const passwordInput = document.getElementById('password');
  const toggleButton = document.getElementById('toggle-password');
  const toggleIcon = document.getElementById('toggle-password-icon');

  if (passwordInput && toggleButton && toggleIcon) {
    toggleButton.addEventListener('click', () => {
      const isPassword = passwordInput.getAttribute('type') === 'password';
      passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
      toggleButton.setAttribute('aria-pressed', String(isPassword));
      toggleIcon.textContent = isPassword ? '🙈' : '👁';
    });
  }
</script>
