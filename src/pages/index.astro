---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import CardOptimized from '../components/CardOptimized.astro';
import appImg from '../assets/cards/app.png';
import gadgets from '../assets/cards/gadgets.png';
import dashboard from '../assets/cards/dashboard.png';
import ContactForm from '../components/ContactForm.astro';
import { supabase } from '../lib/supabaseClient';
import Esponsors from '../components/Esponsors.astro';
import abueloreloj from '../assets/abuelo_reloj.png';
import Picture from 'astro/components/Picture.astro';

const data = [
  {
    imageUrl: appImg,
    title: 'App y plataforma',
    description:
      'En el mundo de la atención médica actual, la precisión es esencial para brindar el mejor cuidado a nuestros pacientes. Con la ayuda de la inteligencia artificial y la innovación en dispositivos de última generación, estamos liderando el camino hacia una atención cardiológica más avanzada y personalizada que nunca.',
    paginaDesti: '/plataforma/',
  },
  {
    imageUrl: gadgets,
    title: 'Nuestra Tecnología de Vanguardia',
    description:
      'Utilizamos dispositivos propios diseñados específicamente para medir su salud cardiovascular de manera precisa y continua. Estos dispositivos incluyen ECGs, holters, parches, implantables y wearables. Nuestra tecnología no solo registra los datos, sino que también utiliza algoritmos de inteligencia artificial de última generación para analizarlos de manera rápida y eficiente.',
    paginaDesti: '/tecnologia/',
  },
  {
    imageUrl: dashboard,
    title: 'Ventajas de nuestra plataforma',
    description: [
      'Precisión Inigualable: Nuestra IA es capaz de detectar incluso las irregularidades más sutiles en su ritmo cardíaco, lo que nos permite intervenir antes de que los problemas empeoren.',
      'Personalización: Su salud es única, y su tratamiento debe serlo también. Nuestra plataforma adapta las recomendaciones y el seguimiento a sus necesidades específicas.',
      'Acceso en Tiempo Real: Los datos de su corazón están disponibles para usted y su equipo médico en tiempo real, lo que permite una toma de decisiones más rápida y efectiva.',
      'Comodidad: Nuestros dispositivos son cómodos y fáciles de usar, lo que facilita el monitoreo constante de su salud cardiovascular.',
    ],
    paginaDesti: '/ventajasplataforma/',
  },
];

export async function formAction({ request }: any) {
  const formData = await request.formData();
  const name = String(formData.get('name') ?? '').trim();
  const surname = String(formData.get('surname') ?? '').trim();
  const email = String(formData.get('email') ?? '').trim();
  const message = String(formData.get('message') ?? '').trim();

  if (!name || !surname || !email || !message) {
    return { error: 'Todos los campos son obligatorios.' };
  }

  const { error } = await supabase
    .from('contact_messages')
    .insert([{ name, surname, email, message }]);
  if (error) return { error: 'Error al guardar el mensaje.' };

  return { success: true };
}

export const actions = {
  contact: formAction,
};
---

<Layout>
  <h1 class="pt-28 md:pt-32 text-4xl md:text-5xl lg:text-6xl text-center my-10">
    Detección y medicina de precisión con IA para cardiología
  </h1>
  <h2 class="text-l md:text-xl lg:text-2xl text-center px-5 mb-10">
    Llevar el poder de la inteligencia artificial a la atención cardiaca
  </h2>

  <div id="hero">
    <div class="relative w-full bg-gray-950 overflow-hidden">
      <div class="relative h-[75vh] w-full">
        <!-- IMAGEN -->
        <Picture
          src={abueloreloj}
          formats={['avif', 'webp']}
          widths={[400, 800, 1200, abueloreloj.width]}
          alt="Anciano con reloj"
          class="absolute inset-0 h-full w-full object-cover z-0"
        />

        <!-- FILTRO Y DEGRADADOS DE BORDE (Reforzados por los cuatro costados) -->

        <!-- 1. Capa de tinte base (opcional, para oscurecer la imagen entera) -->
        <div class="absolute inset-0 bg-gray-950/50 z-10"></div>

        <!-- 2. Degradado Radial (Vignette) - Mantenido para las esquinas y suavizado general -->
        <div
          class="absolute inset-0 z-20"
          style="background: radial-gradient(circle, transparent 0%, #030712 95%);"
        >
        </div>

        <!-- 3. Degradado Lineal ARRIBA - Se desvanece de Gray-950 a Transparente -->
        <div
          class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-gray-950 to-transparent z-25"
        >
        </div>

        <!-- 4. Degradado Lineal ABAJO - Se desvanece de Gray-950 a Transparente -->
        <div
          class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-gray-950 to-transparent z-25"
        >
        </div>

        <!-- CONTENIDO CON SOMBREADO DIFUMINADO Y NATURAL -->
        <div
          class="relative z-30 flex flex-col items-center justify-center h-full text-center px-8"
        >
          <!-- Título: Sombra muy amplia y suave (Glow sutil) -->
          <h1
            class="text-white text-5xl md:text-6xl font-black tracking-tight mb-6
           filter drop-shadow-[0_10px_30px_rgba(0,0,0,0.5)]"
          >
            EL TIEMPO ES SABIDURÍA
          </h1>

          <!-- Texto gray-300: Sombra expandida para separar del fondo sin endurecer las letras -->
          <p
            class="text-gray-300 text-lg md:text-xl max-w-xl font-bold leading-relaxed
           filter drop-shadow-[0_5px_20px_rgba(0,0,0,0.6)]"
          >
            Tecnología diseñada con la calma y precisión que solo los años
            otorgan.
          </p>
        </div>
      </div>
    </div>
    <h2 class="text-3xl md:text-4xl lg:text-5xl text-center my-20">
      Nuestros productos
    </h2>
    <div
      class="mb-10 flex flex-col gap-6 items-center md:flex-row md:items-stretch md:justify-center md:gap-8 px-2 sm:px-4"
    >
      {
        data.map((d) => (
          <CardOptimized
            imageUrl={d.imageUrl}
            title={d.title}
            description={d.description}
            class="mx-0"
            paginaDesti={d.paginaDesti}
          />
        ))
      }
    </div>
    <h2 class="text-3xl md:text-4xl lg:text-5xl text-center my-20">Contacto</h2>
    <div id="contact"></div>
    <ContactForm action={actions.contact} />
    <div class="flex justify-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl text-center my-20">
        Proyecto subvencionado por CDTI
      </h2>
    </div>
    <Esponsors />
  </div>
</Layout>
