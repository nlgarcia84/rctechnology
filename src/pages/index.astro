---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';
import CardOptimized from '../components/CardOptimized.astro';
import appImg from '../assets/cards/app.png';
import gadgets from '../assets/cards/gadgets.png';
import dashboard from '../assets/cards/dashboard.png';
import ContactForm from '../components/ContactForm.astro';
import { actions } from 'astro:actions';
import Soporte from '../components/Soporte.astro';
import Colaboraciones from '../components/Colaboraciones.astro';
import Subvenciones from '../components/Subvenciones.astro';
import { t } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

const locale: Locale = Astro.locals.locale ?? 'es';

const data = [
  {
    imageUrl: appImg,
    title: t(locale, 'home.card1_title'),
    description: t(locale, 'home.card1_desc'),
    paginaDesti: '/plataforma/',
  },
  {
    imageUrl: gadgets,
    title: t(locale, 'home.card2_title'),
    description: t(locale, 'home.card2_desc'),
    paginaDesti: '/tecnologia/',
  },
  {
    imageUrl: dashboard,
    title: t(locale, 'home.card3_title'),
    description: [t(locale, 'home.card3_desc')],
    paginaDesti: '/ventajasplataforma/',
  },
];
---

<Layout>
  <!-- HERO -->
  <div id="hero" class="relative w-full h-[75vh] bg-gray-950 overflow-hidden">
    <!-- VIDEO -->
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover z-0 scale-105"
    >
      <source src="/assets/hero.mp4" type="video/mp4" />
    </video>

    <!-- GRADIENTE SUAVE -->
    <div
      class="absolute inset-0 bg-gradient-to-b from-gray-950/40 via-gray-950/60 to-gray-950/90 z-10"
    >
    </div>

    <!-- VIGNETTE -->
    <div
      class="absolute inset-0 z-20"
      style="background: radial-gradient(circle, transparent 0%, #030712 90%);"
    >
    </div>

    <!-- CONTENIDO -->
    <div
      class="relative z-40 flex flex-col items-center justify-center h-full text-center px-8 pb-8"
    >
      <h1
        class="text-white text-5xl md:text-6xl font-black tracking-tight pb-5 pt-40"
      >
        {t(locale, 'hero.title')}
      </h1>

      <p class="text-gray-300 text-lg md:text-xl font-medium leading-relaxed">
        {t(locale, 'hero.subtitle')}
      </p>

      <a
        href="#productos"
        class="mt-6 px-3 xs:px-6 py-3 bg-red-600 hover:bg-red-700 text-white rounded-xl transition"
      >
        {t(locale, 'hero.cta')}
      </a>
    </div>
  </div>

  <!-- TRANSICIÓN SUAVE -->
  <div class="h-20 bg-gradient-to-b from-gray-950 to-transparent"></div>

  <!-- INTRO -->
  <div id="productos" data-reveal class="text-center px-5">
    <span
      class="text-4xl md:text-5xl text-center my-16 font-thin tracking-tight"
    >
      {t(locale, 'home.intro')}
    </span>
  </div>

  <h2
    data-reveal
    class="text-4xl md:text-xl lg:text-5xl text-center my-16 font-semibold tracking-tight"
  >
    {t(locale, 'home.products_title')}
  </h2>

  <!-- CARDS -->
  <div
    class="mb-16 flex flex-col gap-6 items-center md:flex-row md:items-stretch md:justify-center md:gap-8 px-2 sm:px-4"
  >
    {
      data.map((d) => (
        <CardOptimized
          imageUrl={d.imageUrl}
          title={d.title}
          description={d.description}
          class="mx-0"
          paginaDesti={d.paginaDesti}
        />
      ))
    }
  </div>

  <!-- ABOUT US -->
  <div
    id="aboutus"
    class="relative w-full h-[75vh] bg-gray-950 overflow-hidden"
  >
    <!-- VIDEO -->
    <video
      autoplay
      muted
      loop
      playsinline
      class="absolute inset-0 w-full h-full object-cover z-0 scale-110 blur-[1.5px] brightness-75"
    >
      <source src="/assets/hero2.mp4" type="video/mp4" />
    </video>

    <!-- TINTE BASE -->
    <div class="absolute inset-0 bg-gray-950/60 z-10"></div>

    <!-- VIGNETTE -->
    <div
      class="absolute inset-0 z-20"
      style="background: radial-gradient(circle, transparent 0%, #030712 95%);"
    >
    </div>

    <!-- DEGRADADOS COMO CONTACTFORM -->
    <div
      class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-gray-950 to-transparent z-30"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-gray-950 to-transparent z-30"
    >
    </div>
    <div
      class="absolute inset-y-0 left-0 w-40 bg-gradient-to-r from-gray-950 to-transparent z-30"
    >
    </div>
    <div
      class="absolute inset-y-0 right-0 w-40 bg-gradient-to-l from-gray-950 to-transparent z-30"
    >
    </div>

    <!-- CONTENIDO -->
    <div
      data-reveal
      class="relative z-40 flex flex-col items-center justify-center h-full text-center px-8"
    >
      <h2
        data-reveal
        class="text-4xl md:text-4xl lg:text-5xl text-center my-16 font-semibold tracking-tight"
      >
        {t(locale, 'home.about_title')}
      </h2>

      <p
        data-reveal
        class="text-gray-300 text-lg md:text-3xl sm:px-2 font-medium leading-relaxed"
      >
        {t(locale, 'home.about_text')}
      </p>
    </div>
  </div>

  <!-- CONTACTO -->
  <h2
    data-reveal
    id="contact"
    class="text-4xl md:text-4xl lg:text-5xl text-center my-16 font-semibold tracking-tight"
  >
    {t(locale, 'contact.title')}
  </h2>

  <div data-reveal><ContactForm action={actions.contact} /></div>

  <!-- SPONSORS -->
  <h2
    data-reveal
    class="text-3xl md:text-4xl lg:text-5xl text-center my-16 font-semibold tracking-tight"
  >
    {t(locale, 'home.support_title')}
  </h2>

  <div data-reveal><Soporte /></div>
  <h2
    data-reveal
    class="text-3xl md:text-4xl lg:text-5xl text-center my-16 font-semibold tracking-tight"
  >
    {t(locale, 'home.collab_title')}
  </h2>
  <div data-reveal><Colaboraciones /></div>
  <h2
    data-reveal
    class="text-3xl md:text-4xl lg:text-5xl text-center my-16 font-semibold tracking-tight"
  >
    {t(locale, 'home.grant_title')}
  </h2>
  <div data-reveal><Subvenciones /></div>
</Layout>
