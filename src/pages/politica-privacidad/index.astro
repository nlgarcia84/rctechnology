---
import Layout from '../../layouts/Layout.astro';
import pkg from 'lucide-react';
import { t } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';
const { Home } = pkg;
const locale: Locale = Astro.locals.locale ?? 'es';
const isHomePage = Astro.url.pathname === '/';
---

<Layout>
  <section
    class="min-h-screen bg-gray-950 text-gray-300 px-6 sm:px-10 lg:px-20"
  >
    <div
      class="max-w-4xl mx-auto bg-gray-900/50 backdrop-blur-xl border border-white/10 sm:p-12 rounded-3xl shadow-2xl"
    >
      <header
        class="border-b border-white/10 pb-8 mb-8 flex items-center justify-between gap-4"
      >
        <div>
          <h1 class="text-4xl font-bold text-white mb-2">
            {t(locale, 'legal.privacy_title')}
          </h1>
          <p class="text-sm text-gray-400">{t(locale, 'legal.last_update')}</p>
        </div>
        {
          !isHomePage && (
            <a
              href="/#hero"
              id="go-home"
              class="inline-flex items-center gap-2 rounded-xl border border-brand-500/80 bg-gray-900/80 px-4 py-2 text-brand-400 transition-all hover:bg-brand-500/10"
            >
              <Home className="w-5 h-5" />
            </a>
          )
        }
      </header>

      <article
        class="bg-gray-800/40 rounded-2xl p-6 mb-10 border border-white/5"
      >
        <h2 class="text-xl font-semibold text-white mb-4 flex items-center">
          <span class="w-1.5 h-6 bg-brand-500 rounded-full mr-3"></span>
          {t(locale, 'legal.privacy_controller')}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
          <p>
            <span
              class="text-gray-500 block uppercase text-xs font-bold tracking-wider"
              >{t(locale, 'legal.privacy_company')}:</span
            > RC Technology Solutions SL.
          </p>
          <p>
            <span
              class="text-gray-500 block uppercase text-xs font-bold tracking-wider"
              >CIF:</span
            > B56360894
          </p>
          <p class="md:col-span-2">
            <span
              class="text-gray-500 block uppercase text-xs font-bold tracking-wider"
              >Dirección:</span
            > Gran Vía de les Corts Catalanes 620, ático 4A, 08007 Barcelona, Spain
          </p>
          <p>
            <span
              class="text-gray-500 block uppercase text-xs font-bold tracking-wider"
              >Email:</span
            > rafael@rctechnology.es
          </p>
          <p>
            <span
              class="text-gray-500 block uppercase text-xs font-bold tracking-wider"
              >Teléfono:</span
            > +34 608 848 171
          </p>
        </div>
      </article>

      <div class="space-y-8 text-gray-300 leading-relaxed">
        <section>
          <h2 class="text-2xl font-bold text-white mb-4">{t(locale, 'legal.privacy_section1_title')}</h2>
          <p>
            {t(locale, 'legal.privacy_section1_text')}
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-white mb-4">{t(locale, 'legal.privacy_section2_title')}</h2>
          <p>
            {t(locale, 'legal.privacy_section2_text')}
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-white mb-4">
            {t(locale, 'legal.privacy_section3_title')}
          </h2>
          <p>
            {t(locale, 'legal.privacy_section3_text')}
          </p>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-white mb-4">{t(locale, 'legal.privacy_section4_title')}</h2>
          <p>
            {t(locale, 'legal.privacy_section4_text')}
          </p>
        </section>

        <section class="border-t border-white/10 pt-8 mt-12 text-center">
          <p class="text-sm text-gray-500 italic">
            {t(locale, 'legal.privacy_compliance')}
          </p>
        </section>
      </div>
    </div>
  </section>
</Layout>
