---
import '../styles/global.css';
const { title = 'Login' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-950 text-gray-300 min-h-screen">
    <slot />
  </body>
</html>
