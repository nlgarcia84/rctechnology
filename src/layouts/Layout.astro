---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import pkg from 'lucide-react';
const { Cookie, ArrowUpCircle, Home } = pkg;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>RC TECHNOLOGY</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-gray-950 text-gray-300 flex flex-col min-h-screen pt-24 md:pt-28"
  >
    <Header />

    <main class="grow px-5 pt-5 pb-20">
      <slot />
    </main>

    <button
      id="reset-cookies"
      class="flex items-center justify-center gap-2 text-lg text-green-500 border-green-500 border-2 rounded-xl hover:bg-green-500/10 transition-all w-52 py-2 mb-20 mx-auto font-medium"
    >
      <Cookie className="w-5 h-5 text-green-500" /> Revisar cookies
    </button>

    <Footer class="fixed left-0 bottom-0 w-full z-50" />

    <CookieBanner />

    <!-- SCROLL TRACK -->
    <div
      id="scroll-track"
      class="fixed right-6 top-1/2 -translate-y-1/2 h-[60vh] w-[2px] z-[300] hidden md:block"
    >
      <div
        id="scroll-progress"
        class="absolute inset-x-0 top-0 w-full bg-red-600 origin-top transition-all"
        style="height: 0;"
      ></div>
      <div id="scroll-markers" class="absolute inset-0 -left-[5px]"></div>
    </div>

    <button
      id="return-top"
      class="fixed bottom-0 right-0 m-10 z-[200] opacity-0 pointer-events-none transition-opacity duration-300"
    >
      <ArrowUpCircle className="w-10 h-10" />
    </button>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const SECTIONS = ['hero', 'productos', 'aboutus', 'contact'];

      const initScrollAnimations = () => {
        // ---- Progress line ----
        const progress = document.getElementById('scroll-progress');
        const track = document.getElementById('scroll-track');
        const markersContainer = document.getElementById('scroll-markers');
        if (!progress || !track || !markersContainer) return;

        gsap.to(progress, {
          height: '100%',
          ease: 'none',
          scrollTrigger: {
            trigger: document.body,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.3,
          },
        });

        // ---- Section markers & border animations ----
        const sectionEls = SECTIONS.map((id) =>
          document.getElementById(id),
        ).filter(Boolean);

        // Build markers on the track
        const markerEls = [];
        sectionEls.forEach((el) => {
          const marker = document.createElement('div');
          marker.className =
            'absolute w-3 h-3 rounded-full bg-gray-700 border-2 border-red-600 transition-all duration-500';
          markersContainer.appendChild(marker);
          markerEls.push(marker);
        });

        // Marker positions update on refresh
        const updateMarkers = () => {
          const trackRect = track.getBoundingClientRect();
          const trackHeight = trackRect.height;
          const docHeight =
            document.documentElement.scrollHeight - window.innerHeight;

          sectionEls.forEach((el, i) => {
            const sectionTop = el.getBoundingClientRect().top + window.scrollY;
            const progressRatio = Math.min(sectionTop / docHeight, 1);
            const y = progressRatio * trackHeight;
            markerEls[i].style.top = `${y}px`;
            markerEls[i].style.transform = 'translateY(-50%)';
          });
        };

        // ---- Card reveal animations ----
        const revealEls = document.querySelectorAll('[data-reveal]');
        revealEls.forEach((el, i) => {
          gsap.fromTo(
            el,
            { opacity: 0, y: 30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.6,
              delay: i * 0.1,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                toggleActions: 'play none none none',
              },
            },
          );
        });

        // Update marker positions and active state
        const onScroll = () => {
          updateMarkers();
          sectionEls.forEach((el, i) => {
            const rect = el.getBoundingClientRect();
            const isActive =
              rect.top < window.innerHeight * 0.75 &&
              rect.bottom > window.innerHeight * 0.25;
            markerEls[i].classList.toggle('bg-red-600', isActive);
            markerEls[i].classList.toggle('scale-150', isActive);
            markerEls[i].classList.toggle('shadow-glow', isActive);
          });
        };

        updateMarkers();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', updateMarkers);

        // Clean up old ScrollTriggers on re-init
        return () => {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', updateMarkers);
          ScrollTrigger.getAll().forEach((st) => st.kill());
          markerEls.forEach((m) => m.remove());
        };
      };

      let cleanup = initScrollAnimations();
      document.addEventListener('astro:after-swap', () => {
        if (cleanup) cleanup();
        cleanup = initScrollAnimations();
      });

      // Lógica para resetear cookies
      document
        .getElementById('reset-cookies')
        ?.addEventListener('click', () => {
          localStorage.removeItem('cookie-consent');
          location.reload();
        });

      // Transicion smooth del scrool top
      const returnTop = document.getElementById('return-top');
      returnTop?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // Ocultar botón cuando top = 0
      window.addEventListener('scroll', () => {
        if (!returnTop) return;
        if (window.scrollY > 0) {
          returnTop.classList.remove('opacity-0', 'pointer-events-none');
        } else {
          returnTop.classList.add('opacity-0', 'pointer-events-none');
        }
      });
    </script>
  </body>
</html>
